// Cloudflare Workers static site: serves the Vite build in dist/.
{
  "name": "stargaze",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // `wrangler preview` (branch builds) refuses to run without this block; empty is fine.
  "previews": {}
}
